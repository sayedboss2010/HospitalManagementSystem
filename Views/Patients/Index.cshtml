@model IEnumerable<Patient><div class="d-flex justify-content-between mb-3"><h2>المرضى</h2><a class="btn btn-primary" asp-action="Create">مريض جديد</a></div><form class="mb-3"><input name="q" class="form-control" placeholder="بحث بالاسم أو رقم الملف أو الهاتف"></form><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>رقم الملف</th><th>الاسم</th><th>الهاتف</th><th>الرقم القومي</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FileNumber</td><td>@x.FullName</td><td>@x.Phone</td><td>@x.NationalId</td></tr>}</tbody></table></div></div>
