@model Patient<h2>تسجيل مريض</h2><form method="post" class="card p-4 mt-3"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label>رقم الملف</label><input asp-for="FileNumber" class="form-control"></div><div class="col-md-8"><label>اسم المريض</label><input asp-for="FullName" class="form-control"></div><div class="col-md-4"><label>الرقم القومي</label><input asp-for="NationalId" class="form-control"></div><div class="col-md-4"><label>الهاتف</label><input asp-for="Phone" class="form-control"></div><div class="col-md-4"><label>النوع</label><select asp-for="Gender" class="form-select"><option>ذكر</option><option>أنثى</option></select></div><div class="col-12"><label>العنوان</label><input asp-for="Address" class="form-control"></div></div><button class="btn btn-primary mt-4">حفظ</button></form>
